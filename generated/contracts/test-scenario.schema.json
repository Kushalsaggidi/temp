{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realpage.local/ai-marketplace/contracts/test-scenario.schema.json",
  "title": "Test Scenario",
  "type": "object",
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^scenario_[a-z0-9]+(?:_[a-z0-9]+)*$",
      "description": "Test scenario identifier"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "input_fixture": {
      "$ref": "#/$defs/__schema0"
    },
    "expected_usefulness": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "expected_safety": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "output_schema_expectations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    }
  },
  "required": [
    "scenario_id",
    "label",
    "description",
    "input_fixture",
    "expected_usefulness",
    "expected_safety",
    "output_schema_expectations"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    }
  }
}
