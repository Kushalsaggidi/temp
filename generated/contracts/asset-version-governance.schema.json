{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realpage.local/ai-marketplace/contracts/asset-version-governance.schema.json",
  "title": "Asset Version Governance",
  "type": "object",
  "properties": {
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "in_review",
        "changes_requested",
        "published",
        "deprecated"
      ]
    },
    "subject_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "published_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "deprecated_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement_version": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^av_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "description": "Immutable asset-version identifier"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "lifecycle",
    "subject_digest",
    "published_at",
    "deprecated_at",
    "replacement_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO 8601 UTC timestamp ending in Z"
    }
  }
}
