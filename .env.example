# Optional. Defaults to ./data/marketplace.sqlite.
DATABASE_PATH=./data/marketplace.sqlite

# Optional AI is disabled by default and is never required to start the app.
AI_PROVIDER=disabled

# Required only when AI_PROVIDER=gemini. Keep the real value in a gitignored .env file.
GEMINI_API_KEY=

# Optional per-attempt provider timeout, bounded to 250-10000 milliseconds.
DISCOVERY_AI_TIMEOUT_MS=4000

# Recommended for local hackathon development and CI.
NEXT_TELEMETRY_DISABLED=1
